{
  "name": "knowledge-card-game",
  "version": "2.0.0",
  "description": "知识卡牌对战游戏 — 客户端/服务端联机架构",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server:build": "npx tsc --project tsconfig.server.json",
    "server:start": "node dist-server/server/index.js",
    "server:dev": "npx tsx server/index.ts",
    "full:build": "npm run build && npm run server:build",
    "pack": "node scripts/pack.mjs",
    "pack:zip": "npm run full:build && cd dist && zip -r ../knowledge-card-game.zip ."
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.0",
    "uuid": "^13.0.0",
    "ws": "^8.18.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.12"
  }
}
